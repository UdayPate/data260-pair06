# Settings for `docker compose` (Pair 06). Copy this file to  .env  (it is git-ignored) and change the values.
# Never commit .env: it holds passwords.

# MongoDB's administrator account. The password goes into a connection URL, so use letters, digits and hyphens only.
MONGO_USER=p06admin
MONGO_PASSWORD=change-me-mongo-password

# The secret that signs login tokens (JWT). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string

# Optional (the defaults are shown):
# TAG=1.0.0                                      # image version: p06-<service>:<TAG>
# PUBLIC_API_URL=http://localhost:9060           # the gateway address the BROWSER uses; built into the website image
# OLLAMA_URL=http://host.docker.internal:11434   # where the AI assistant finds Ollama (it runs on your machine, not in Docker)
# OLLAMA_MODEL=qwen3:8b
