# Copy this file to backend/.env and fill in YOUR values. backend/.env is git-ignored: never commit it.
# MongoDB connection string. Local MongoDB without a password:
MONGO_URL=mongodb://localhost:27017
# With a user and password (Docker Compose / Kubernetes use a Secret for this):
# MONGO_URL=mongodb://USER:PASSWORD@localhost:27017/?authSource=admin
MONGO_DB_NAME=p06_handshake
JWT_SECRET=replace-with-a-long-random-string
