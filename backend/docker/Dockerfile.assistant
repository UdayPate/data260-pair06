# p06-assistant  (Pair 06, port 9067)
# Build from the backend/ folder:  docker build -f docker/Dockerfile.assistant -t p06-assistant:1.0.0 .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /srv

# Install ONLY what this service needs (requirements/assistant.txt), before copying the code,
# so Docker re-uses this layer when only the code changes.
COPY requirements/base.txt requirements/assistant.txt requirements/
RUN pip install -r requirements/assistant.txt

# The shared Lab 1 code, plus this service's own entry point.
COPY app/ app/
COPY services/__init__.py services/common.py services/
COPY services/assistant/ services/assistant/

# Run as a normal user, not root. Nothing is written to disk: resumes and pictures live in MongoDB (GridFS).
# The connection string comes from the MONGO_URL environment variable (a Secret in Kubernetes), never from the image.
RUN useradd --system --uid 10001 p06
USER p06

EXPOSE 9067

# "Healthy" = GET /health answers 200. (Python is already in the image, so no curl is needed.)
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9067/health', timeout=2).status == 200 else 1)"

CMD ["uvicorn", "services.assistant.main:app", "--host", "0.0.0.0", "--port", "9067"]
