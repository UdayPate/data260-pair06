# p06-job  (Pair 06, port 9064)
# Build from the backend/ folder:  docker build -f docker/Dockerfile.job -t p06-job:1.0.0 .
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    UPLOAD_DIR=/srv/uploads

WORKDIR /srv

# Install ONLY what this service needs (requirements/job.txt), before copying the code,
# so Docker re-uses this layer when only the code changes.
COPY requirements/base.txt requirements/job.txt requirements/
RUN pip install -r requirements/job.txt

# The shared Lab 1 code, plus this service's own entry point.
COPY app/ app/
COPY services/__init__.py services/common.py services/
COPY services/job/ services/job/

# Run as a normal user, not root. UPLOAD_DIR must be writable by that user.
RUN useradd --system --uid 10001 p06 && mkdir -p $UPLOAD_DIR && chown -R p06 /srv
USER p06

EXPOSE 9064

# "Healthy" = GET /health answers 200. (Python is already in the image, so no curl is needed.)
HEALTHCHECK --interval=15s --timeout=3s --start-period=15s --retries=3 \
    CMD python -c "import sys, urllib.request; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:9064/health', timeout=2).status == 200 else 1)"

CMD ["uvicorn", "services.job.main:app", "--host", "0.0.0.0", "--port", "9064"]
